<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aliasContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:paddingTop="64dp"
    android:paddingBottom="64dp">

    <EditText
        android:id="@+id/addressInput"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:hint="alias"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/reloadAliasButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Generate new alias"
        android:src="@android:drawable/ic_menu_rotate"
        app:layout_constraintStart_toEndOf="@id/addressInput"
        app:layout_constraintTop_toTopOf="@id/addressInput"
        app:layout_constraintBottom_toBottomOf="@id/addressInput"
        android:layout_marginStart="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <EditText
        android:id="@+id/gotoInput"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:hint="goto"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/addressInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/privcomment"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:hint="priv comment"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/gotoInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/pubcomment"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:hint="pub comment"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/privcomment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/createAliasButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create alias"
        app:layout_constraintTop_toBottomOf="@id/pubcomment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
